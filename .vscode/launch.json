{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 — builds and runs the package containing the file you are looking at.
      // Breakpoints, variable inspection and stepping all work.
      "name": "Run package of current file",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}",
      "console": "integratedTerminal"
    },
    {
      // Escape hatch: compiles ONLY the open file, ignoring its siblings.
      // Useful when a directory temporarily holds more than one func main().
      "name": "Run this file only",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Test package of current file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.v"],
      "console": "integratedTerminal"
    }
  ]
}
